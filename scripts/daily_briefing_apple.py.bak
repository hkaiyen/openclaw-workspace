#!/usr/bin/env python3
"""
每日簡報：行事曆 + 代辦事項 + 郵件摘要
匯出為 Word 文件
"""

import subprocess
import datetime
import requests
from docx import Document
from docx.shared import Pt, Cm, RGBColor
from docx.enum.text import WD_ALIGN_PARAGRAPH

# ========== 設定區 ==========
TELEGRAM_TOKEN = "8546064006:AAE3Bw90cbOmN6hsKuUQVzMFI6BzdM55iUk"
TELEGRAM_CHAT_ID = "8766466278"
# ========================

def run_script(script, timeout=30):
    """執行 AppleScript 並回傳結果"""
    try:
        result = subprocess.run(
            ['osascript', '-e', script],
            capture_output=True,
            text=True,
            timeout=timeout
        )
        if result.returncode != 0 and result.stderr:
            return f"(Script錯誤)"
        return result.stdout.strip() or "(無資料)"
    except subprocess.TimeoutExpired:
        return "(讀取逾時)"
    except Exception as e:
        return f"(錯誤)"

def get_calendar_events():
    """取得今日行程"""
def get_calendar_events():
    """分開查詢每個日曆，加強錯誤處理"""
    script = '''
    set output to ""
    set today to current date
    set endDate to today + (31 * days)
    
    tell application "Calendar"
        set calList to {"Work", "Family", "台灣節日"}
        
        repeat with calName in calList
            try
                set evtList to (events of calendar calName whose (start date ≥ today and start date < endDate))
                set evtCount to length of evtList
                
                if evtCount > 0 then
                    set output to output & "📅 " & calName & " (" & evtCount & "筆):" & return
                    
                    -- 按日期排序
                    set sortedList to {}                    
                    repeat with i from 1 to evtCount
                        set evt to item i of evtList
                        try
                            set evtStart to start date of evt
                            set sortedList to sortedList & {{evtDate:evtStart, evtRef:evt}}
                        end try
                    end repeat
                    
                    -- 交換式排序（由近到遠）
                    set sortedCount to length of sortedList
                    repeat with i from 1 to sortedCount
                        set changeFlag to false
                        repeat with j from 1 to (sortedCount - i)
                            set item1 to item j of sortedList
                            set item2 to item (j + 1) of sortedList
                            if (evtDate of item1) > (evtDate of item2) then
                                set item j of sortedList to item2
                                set item (j + 1) of sortedList to item1
                                set changeFlag to true
                            end if
                        end repeat
                        if not changeFlag then exit repeat
                    end repeat
                    
                    set dispLimit to 15
                    if evtCount < 15 then set dispLimit to evtCount
                    repeat with i from 1 to dispLimit
                        try
                            set evt to evtRef of item i of sortedList
                            try
                                set evtTitle to summary of evt
                            on error
                                set evtTitle to "(無標題)"
                            end try
                            set evtDate to start date of evt
                            set dateStr to short date string of evtDate
                            if evtTitle is "" then set evtTitle to "(無標題)"
                            set output to output & "  • " & dateStr & " " & evtTitle & return
                        on error
                            set output to output & "  • (無法讀取此事件)" & return
                        end try
                    end repeat
                    
                    if evtCount > 15 then
                        set output to output & "  ...還有 " & (evtCount - 15) & " 筆" & return
                    end if
                    set output to output & return
                end if
            on error errMsg
                set output to output & "Error: " & calName & " - " & errMsg & return
            end try
        end repeat
        
        if output is "" then
            set output to "✅ 未來一個月無行程"
        end if
    end tell
    
    return output
    '''
    return run_script(script, timeout=300)

def get_reminders():
    """取得代辦事項"""
    script = '''
    set output to ""
    set totalCount to 0
    
    tell application "Reminders"
        set remLists to every list
        
        repeat with eachList in remLists
            set listName to name of eachList
            set remItems to (every reminder in eachList whose completed is false)
            set remCount to length of remItems
            
            if remCount > 0 then
                set totalCount to totalCount + remCount
                if output is not "" then
                    set output to output & return
                end if
                set output to output & "📋 " & listName & " (" & remCount & "項):" & return
                
                set dispCount to 0
                repeat with i from 1 to remCount
                    if dispCount ≥ 5 then exit repeat
                    set rem to item i of remItems
                    try
                        set remName to name of rem
                        if remName is not "" then
                            try
                                set remDue to due date of rem
                                if remDue is not missing value then
                                    set dueStr to short date string of remDue
                                    set output to output & "  ☐ " & remName & " (" & dueStr & ")" & return
                                else
                                    set output to output & "  ☐ " & remName & return
                                end if
                            on error
                                set output to output & "  ☐ " & remName & return
                            end try
                            set dispCount to dispCount + 1
                        end if
                    end try
                end repeat
                
                if remCount > 5 then
                    set output to output & "  ...還有 " & (remCount - 5) & " 項"
                end if
            end if
        end repeat
        
        if output is "" then
            set output to "✅ 所有待辦已完成！"
        else
            set output to output & return & "━━━━━━━━━━━━" & return & "共 " & totalCount & " 項待辦"
        end if
    end tell
    
    return output
    '''
    return run_script(script, timeout=60)

def get_gmail_count():
    """取得郵件數量"""
    script = '''
    tell application "Mail"
        set unreadCount to unread count of inbox
        return unreadCount
    end tell
    '''
    return run_script(script)

def create_word_doc(events, reminders, mail_count, today_str):
    """建立 Word 文件"""
    doc = Document()
    
    # 設定頁面
    for section in doc.sections:
        section.top_margin = Cm(2)
        section.bottom_margin = Cm(2)
        section.left_margin = Cm(2.5)
        section.right_margin = Cm(2.5)
    
    # ===== 標題 =====
    title = doc.add_heading(f'📅 每日簡報 - {today_str}', 0)
    title.alignment = WD_ALIGN_PARAGRAPH.CENTER

    # ===== 未來行程 =====
    h1 = doc.add_heading('📅 未來行程', level=1)
    h1.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)
    p1 = doc.add_paragraph(events)
    p1.paragraph_format.space_after = Pt(6)
    
    # 郵件
    doc.add_heading('📧 郵件', level=1)
    p = doc.add_paragraph(f'📬 未讀郵件: {mail_count} 封')
    
    # ===== 代辦事項 =====
    h3 = doc.add_heading('📋 待辦事項', level=1)
    h3.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)
    p3 = doc.add_paragraph(reminders)
    p3.paragraph_format.space_after = Pt(6)
    
    # 頁尾
    doc.add_paragraph('')
    footer = doc.add_paragraph('📎 小安助理')
    footer.alignment = WD_ALIGN_PARAGRAPH.RIGHT
    footer_run = footer.runs[0]
    footer_run.font.size = Pt(9)
    footer_run.font.color.rgb = RGBColor(0x88, 0x88, 0x88)
    
    return doc

def send_telegram_doc(filepath, caption):
    """發送 Word 文件到 Telegram"""
    import requests
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendDocument"
    with open(filepath, 'rb') as f:
        files = {'document': f}
        data = {'chat_id': TELEGRAM_CHAT_ID, 'caption': caption}
        resp = requests.post(url, files=files, data=data, timeout=30)
    return resp.status_code == 200

def main():
    today = datetime.datetime.now().strftime('%Y年%m月%d日 %A')
    date_file = datetime.datetime.now().strftime('%Y%m%d_%H%M')
    
    print("📋 開始生成每日簡報...")
    
    # 取得各項資料
    print("  📅 讀取行事曆...")
    events = get_calendar_events()
    
    print("  ✅ 讀取代辦事項...")
    reminders = get_reminders()
    
    print("  📧 讀取郵件...")
    mail_count = get_gmail_count()
    
    # 建立 Word 文件
    print("  📄 建立 Word 文件...")
    doc = create_word_doc(events, reminders, mail_count, today)
    
    # 儲存
    filename = f'每日簡報_{date_file}.docx'
    filepath = f'/Users/hsuehkaiyen/Desktop/{filename}'
    doc.save(filepath)
    
    print(f"\n✅ 已儲存: {filepath}")
    
    # 發送到 Telegram
    print("\n📤 發送到 Telegram...")
    if send_telegram_doc(filepath, f"📅 每日簡報 - {today}"):
        print("✅ 已發送到 Telegram")
    else:
        print("⚠️ Telegram 發送失敗")
    
    print("\n" + "="*40)
    print("📋 簡報內容預覽：")
    print("="*40)
    print(f"📅 今日行程\n{events}\n")
    print(f"📧 郵件\n📬 未讀郵件: {mail_count} 封\n")
    print(f"✅ 待辦事項\n{reminders}")
    print("="*40)

if __name__ == "__main__":
    main()
