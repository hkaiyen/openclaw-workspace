請用繁體中文回答，報告要詳細、完整、專業。
"""
    return prompt

# ====== 解析 Gemini 回應 ======

def parse_gemini_response(text):
    """將 Gemini 回應轉換為章節"""
    # Gemini 會回應完整的文字，我們需要解析它
    # 這裡我們直接使用 Gemini 的回應作為內容
    
    sections = []
    
    # 簡單地分割章節
    chapters = [
        "第一章", "第二章", "第三章", "第四章", "第五章",
        "第六章", "第七章", "第八章", "第九章", "第十章"
    ]
    
    # 找到每章節的位置
    positions = []
    for i, chapter in enumerate(chapters):
        pos = text.find(chapter)
        if pos != -1:
            positions.append((pos, chapter, i))
    
    # 分割內容
    positions.sort()
    
    for i in range(len(positions)):
        start = positions[i][0]
        end = positions[i+1][0] if i+1 < len(positions) else len(text)
        section_text = text[start:end].strip()
        if section_text:
            sections.append(section_text)
    
    # 如果沒找到章節，整個回應作為一個大章節
    if not sections:
        sections.append(text)
    
    return sections

# ====== 生成 Word 報告 ======

def create_report(gemini_text):
    """建立 Word 報告"""
    
    print("\n📝 正在生成 Word 報告...")
    
    doc = Document()
    
    for section in doc.sections:
        section.top_margin = Cm(2)
        section.bottom_margin = Cm(2)
        section.left_margin = Cm(2.5)
        section.right_margin = Cm(2.5)
    
    # 封面
    add_title(doc, "餐飲創業研究報告", 0)
    add_title(doc, "（Gemini AI 研究）", 1)
    
    date_para = doc.add_paragraph()
    date_para.alignment = WD_ALIGN_PARAGRAPH.CENTER
    dr = date_para.add_run(f"研究日期：{datetime.now().strftime('%Y年%m月%d日 %H:%M')}")
    dr.font.size = Pt(10)
    dr.font.color.rgb = RGBColor(0x99, 0x99, 0x99)
    
    doc.add_paragraph()
    
    # 投資者條件
    add_divider(doc)
    add_section(doc, "投資者條件", "📋")
    
    params = [
        ("投資金額", "500萬新台幣"),
        ("地點", "台北市文山區、新北市新店區"),
        ("參與程度", "管理 + 財務"),
        ("研究方式", "Google Gemini AI 自動化"),
    ]
    
    for key, value in params:
        p = doc.add_paragraph()
        p.add_run(f"  {key}：").bold = True
        p.add_run(value)
    
    doc.add_paragraph()
    
    # 研究內容
    add_divider(doc)
    add_title(doc, "研究報告內容", 1)
    
    # 將 Gemini 回應分段加入文件
    # Gemini 的回應可能是連續文字，我們需要優化格式
    
    lines = gemini_text.split('\n')
    current_heading = None
    
    for line in lines:
        line = line.strip()
        if not line:
            continue
        
        # 偵測章節標題
        is_heading = False
        for i in range(1, 11):
            if line.startswith(f"第{i}章") or line.startswith(f"第{i}张"):
                add_divider(doc)
                add_section(doc, line, "📌")
                is_heading = True
                current_heading = line
                break
        
        # 偵測小標題
        if not is_heading:
            for marker in ["【", "■", "●", "◆", "◎", "★"]:
                if line.startswith(marker):
                    add_major_point(doc, line)
                    is_heading = True
                    break
        
        # 如果是表格行
        if not is_heading and ('|' in line or '─' in line):
            continue  # 跳過表格線
        
        # 如果是普通文字
        if not is_heading and len(line) > 10:
            add_bullet(doc, line)
    
    # 頁尾
    doc.add_paragraph()
    footer = doc.add_paragraph()
    footer.alignment = WD_ALIGN_PARAGRAPH.CENTER
    fr = footer.add_run("小安智能助理 + Gemini AI｜餐飲創業研究報告")
    fr.font.size = Pt(9)
    fr.font.color.rgb = RGBColor(0xAA, 0xAA, 0xAA)
    
    # 儲存
    filename = f"餐飲創業研究_Gemini_{datetime.now().strftime('%Y%m%d_%H%M')}.docx"
    output = OUTPUT_PATH + filename
    doc.save(output)
    
    print(f"✅ 報告已儲存: {output}")
    return output, gemini_text

# ====== 發送到 Telegram ======

def send_to_telegram(docx_path, summary_text=""):
    """發送到 Telegram"""
    import subprocess
    
    caption = f"""🍜 餐飲創業研究報告

研究日期：{datetime.now().strftime('%Y年%m月%d日 %H:%M')}
研究方式：Google Gemini AI

━━━━━━━━━━━━━━━━━━

報告重點摘要：

{summary_text[:500]}...

━━━━━━━━━━━━━━━━━━

由 Gemini AI 自動化生成
小安智能助理出品"""

    cmd = [
        'curl', '-s', '-X', 'POST',
        f'https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendDocument',
        '-F', f'chat_id={TELEGRAM_CHAT_ID}',
        '-F', f'document=@{docx_path}',
        '-F', f'caption={caption}'
    ]
    
    result = subprocess.run(cmd, capture_output=True, text=True)
    response = json.loads(result.stdout)
    
    if response.get('ok'):
        print("✅ 已發送到 Telegram")
        return True
    else:
        print(f"❌ 發送失敗: {response.get('description')}")
        return False

# ====== 主程式 ======

def main():
    print("=" * 60)
    print("🍜 餐飲創業研究 - Gemini API 自動化")
    print("=" * 60)
    print(f"時間：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print()
    
    try:
        # Step 1: 生成 Prompt
        print("📋 Step 1: 生成研究Prompt...")
        prompt = generate_research_prompt()
        print(f"✅ Prompt 已生成（{len(prompt)} 字）")
        
        # Step 2: 呼叫 Gemini API
        print("\n🤖 Step 2: 呼叫 Gemini API...")
        gemini_text = call_gemini(prompt)
        
        if not gemini_text:
            print("❌ Gemini API 呼叫失敗")
            return
        
        print(f"✅ 收到 Gemini 回應（{len(gemini_text)} 字）")
        
        # Step 3: 生成報告
        print("\n📝 Step 3: 生成 Word 報告...")
        docx_path, full_text = create_report(gemini_text)
        
        # Step 4: 發送到 Telegram
        print("\n📱 Step 4: 發送到 Telegram...")
        send_to_telegram(docx_path, full_text[:1000])
        
        print()
        print("=" * 60)
        print("✅ 研究完成！")
        print("=" * 60)
        
    except Exception as e:
        print(f"\n❌ 錯誤：{e}")
        import traceback
        traceback.print_exc()

if __name__ == "__main__":
    main()
