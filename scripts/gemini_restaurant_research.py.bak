import requests
from datetime import datetime
from docx import Document
from docx.shared import Pt, RGBColor, Cm
from docx.enum.text import WD_ALIGN_PARAGRAPH

# ====== 設定 ======
GEMINI_API_KEY = "AIzaSyB4bk58W8EStT0Uh5Xv6kb2Ci5ESqI_IzM"
GEMINI_API_URL = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent"

TELEGRAM_BOT_TOKEN = "8546064006:AAE3Bw90cbOmN6hsKuUQVzMFI6BzdM55iUk"
TELEGRAM_CHAT_ID = "8766466278"

OUTPUT_PATH = "/Users/hsuehkaiyen/Desktop/📂 OpenClaw_下載/reports/weekly/"

# ====== 格式化函數 ======

def add_title(doc, text, level=0):
    h = doc.add_heading(text, level)
    h.alignment = WD_ALIGN_PARAGRAPH.CENTER
    for run in h.runs:
        run.font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)
    return h

def add_section(doc, text, emoji="◆"):
    p = doc.add_paragraph()
    run = p.add_run(f"{emoji} {text}")
    run.bold = True
    run.font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)
    run.font.size = Pt(14)
    return p

def add_major_point(doc, text):
    p = doc.add_paragraph()
    run = p.add_run(f"  {text}")
    run.bold = True
    run.font.size = Pt(11)
    return p

def add_bullet(doc, text):
    p = doc.add_paragraph()
    p.add_run(f"     ● {text}")
    p.paragraph_format.left_indent = Cm(0.8)
    return p

def add_point(doc, text, indent=0.5):
    p = doc.add_paragraph()
    p.add_run(f"  {text}")
    p.paragraph_format.left_indent = Cm(indent)
    return p

def add_note(doc, text):
    p = doc.add_paragraph()
    run = p.add_run(f"     📝 {text}")
    run.font.italic = True
    run.font.size = Pt(10)
    return p

def add_divider(doc):
    p = doc.add_paragraph()
    p.add_run("─" * 40)
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER

def add_checkbox(doc, text):
    p = doc.add_paragraph()
    p.add_run(f"  ☐ {text}")
    p.paragraph_format.left_indent = Cm(0.5)
    return p

def add_calc(doc, text):
    p = doc.add_paragraph()
    run = p.add_run(f"     📐 {text}")
    run.font.name = 'Courier New'
    run.font.size = Pt(9)
    return p

# ====== Gemini API 呼叫 ======

def call_gemini(prompt, max_tokens=8192):
    """呼叫 Gemini API"""
    print(f"\n🤖 正在呼叫 Gemini API...")
    
    url = f"{GEMINI_API_URL}?key={GEMINI_API_KEY}"
    
    headers = {"Content-Type": "application/json"}
    
    data = {
        "contents": [{
            "parts": [{"text": prompt}]
        }],
        "generationConfig": {
            "maxOutputTokens": max_tokens,
            "temperature": 0.7,
        }
    }
    
    try:
        response = requests.post(url, headers=headers, json=data, timeout=120)
        result = response.json()
        
        if "error" in result:
            print(f"❌ API 錯誤：{result['error']['message']}")
            return None
        
        text = result["candidates"][0]["content"]["parts"][0]["text"]
        print(f"✅ Gemini 回應成功（{len(text)} 字）")
        return text
    
    except Exception as e:
        print(f"❌ 錯誤：{e}")
        return None

# ====== 生成研究Prompt ======

def generate_research_prompt():
    """生成研究Prompt"""
    
    prompt = """
你是一個專業的餐飲業創業顧問。請根據以下條件，生成一份完整的餐飲創業研究報告：

【投資者條件】
- 投資金額：500萬新台幣（僅能開一家店）
- 地點偏好：台北市文山區（景美/木柵）、新北市新店區
