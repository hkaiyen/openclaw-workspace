#!/usr/bin/env python3
"""
每日行程彙整報告生成腳本
- 讀取 Gmail 重要郵件
- 讀取 macOS 行事曆
- 讀取 macOS 代辦事項
- 產出 Word 報告
"""

from docx import Document
from docx.shared import Pt, RGBColor, Cm
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.oxml.ns import qn
from docx.oxml import OxmlElement
import subprocess
import datetime
import json
import os
import sys

# ========== 工具函數 ==========

def set_cell_bg(cell, hex_color):
    tc = cell._tc
    tcPr = tc.get_or_add_tcPr()
    shd = OxmlElement('w:shd')
    shd.set(qn('w:val'), 'clear')
    shd.set(qn('w:color'), 'auto')
    shd.set(qn('w:fill'), hex_color)
    tcPr.append(shd)

def make_header_cell(cell, text, bg='1F497D'):
    cell.text = text
    run = cell.paragraphs[0].runs[0]
    run.bold = True
    run.font.color.rgb = RGBColor(0xFF, 0xFF, 0xFF)
    run.font.size = Pt(10)
    set_cell_bg(cell, bg)
    cell.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.CENTER

def add_data_cell(cell, text):
    cell.text = text
    run = cell.paragraphs[0].runs[0]
    run.font.size = Pt(9)
    cell.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.LEFT

# ========== Apple 行事曆 ==========

def get_calendar_events():
    script = '''tell application "Calendar"
        set nowDate to current date
        set weekLater to nowDate + (7 * days)
        set output to ""
        tell calendar "行事曆"
            try
                set evs to events where start date > nowDate and start date < weekLater
                repeat with ev in evs
                    set evName to summary of ev
                    set evStart to start date of ev
                    set evEnd to end date of ev
                    if evName is not "" then
                        set output to output & short date string of evStart & " " & time string of evStart & "|" & evName & "|"
                    end if
                end repeat
            end try
        end tell
        return output
    end tell'''
    
    try:
        result = subprocess.run(['osascript', '-e', script], capture_output=True, text=True, timeout=10)
        events = []
        if result.stdout.strip():
            for line in result.stdout.strip().split('\n'):
                if '|' in line:
                    parts = line.split('|')
                    if len(parts) >= 2:
                        events.append({'date': parts[0], 'name': parts[1]})
        return events
    except:
        return []

# ========== Apple 代辦事項 ==========

def get_reminders():
    script = '''tell application "Reminders"
        set rems to reminders where completed is false
        set output to ""
        repeat with r in rems
            set rName to name of r
            if rName is not "" then
                set output to output & rName & "|"
            end if
        end repeat
        return output
    end tell'''
    
    try:
        result = subprocess.run(['osascript', '-e', script], capture_output=True, text=True, timeout=15)
        reminders = []
        if result.stdout.strip():
            for name in result.stdout.strip().split('|'):
                if name.strip():
                    reminders.append(name.strip())
        return reminders
    except Exception as e:
        print(f'Reminders error: {e}')
        return []

# ========== Gmail ==========

def get_gmail_important():
    try:
        sys.path.insert(0, '/Users/hsuehkaiyen/Desktop/📂 OpenClaw_下載/reports/daily/google_drive')
        from list_files import get_credentials
        from googleapiclient.discovery import build
        
        creds = get_credentials()
        service = build('gmail', 'v1', credentials=creds)
        
        results = service.users().messages().list(
            userId='me', 
            q='is:unread (理財 OR 投資 OR 股票 OR 銀行 OR 證券 OR 基金 OR ETF OR 工作 OR 重要) newer_than:3d',
            maxResults=5
        ).execute()
        messages = results.get('messages', [])
        
        emails = []
        for msg in messages[:5]:
            msg_data = service.users().messages().get(userId='me', id=msg['id'], format='metadata').execute()
            subject = ''
            sender = ''
            for header in msg_data['payload']['headers']:
                if header['name'] == 'Subject':
                    subject = header['value']
                if header['name'] == 'From':
                    sender = header['value']
            snippet = msg_data.get('snippet', '')
            emails.append({'subject': subject, 'from': sender, 'snippet': snippet})
        return emails
    except Exception as e:
        print(f'Gmail error: {e}')
        return []

# ========== 主程式 ==========

def generate_report():
    today = datetime.datetime.now()
    date_str = today.strftime('%Y%m%d_%H%M')

    doc = Document()
    for section in doc.sections:
        section.top_margin = Cm(2)
        section.bottom_margin = Cm(2)
        section.left_margin = Cm(2.5)
        section.right_margin = Cm(2.5)

    # ===== 標題 =====
    title = doc.add_heading('📋 每日行程彙整', 0)
    title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    tr = title.runs[0]
    tr.font.size = Pt(24)
    tr.font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    date_para = doc.add_paragraph()
    date_para.alignment = WD_ALIGN_PARAGRAPH.CENTER
    dr = date_para.add_run(f'報告日期：{today.strftime("%Y年%m月%d日 %H:%M")}')
    dr.font.size = Pt(10)
    dr.font.color.rgb = RGBColor(0x99, 0x99, 0x99)

    doc.add_paragraph()

    # ===== 📧 Gmail 重要郵件 =====
    h1 = doc.add_heading('📧 重要郵件（近3天）', level=1)
    h1.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    emails = get_gmail_important()
    if emails:
        for email in emails:
            p = doc.add_paragraph()
            p.add_run(f'📌 {email["subject"]}\n').bold = True
            sender = email['from'].split('<')[0].strip() if '<' in email['from'] else email['from']
            p.add_run(f'   寄件者：{sender}\n')
            p.add_run(f'   摘要：{email["snippet"][:60]}...')
            p.paragraph_format.space_after = Pt(6)
            p.paragraph_format.left_indent = Cm(0.3)
    else:
        p = doc.add_paragraph()
        p.add_run('（無重要郵件）')
        p.paragraph_format.space_after = Pt(6)

    doc.add_paragraph()

    # ===== 📅 行事曆 =====
    h2 = doc.add_heading('📅 行事曆（未來7天）', level=1)
    h2.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    events = get_calendar_events()
    if events:
        for ev in events:
            p = doc.add_paragraph()
            p.add_run(f'📆 {ev["date"]} {ev["name"]}')
            p.paragraph_format.space_after = Pt(4)
            p.paragraph_format.left_indent = Cm(0.3)
    else:
        p = doc.add_paragraph()
        p.add_run('（未來7天無行程）')
        p.paragraph_format.space_after = Pt(6)

    doc.add_paragraph()

    # ===== ✅ 代辦事項 =====
    h3 = doc.add_heading('✅ 待辨事項', level=1)
    h3.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    reminders = get_reminders()
    if reminders:
        for r in reminders:
            p = doc.add_paragraph()
            p.add_run(f'☐ {r}')
            p.paragraph_format.space_after = Pt(4)
            p.paragraph_format.left_indent = Cm(0.3)
    else:
        p = doc.add_paragraph()
        p.add_run('（無待辨事項）')
        p.paragraph_format.space_after = Pt(6)

    doc.add_paragraph()

    # ===== 頁尾 =====
    footer = doc.sections[0].footer
    fp = footer.paragraphs[0]
    fp.alignment = WD_ALIGN_PARAGRAPH.CENTER
    fr = fp.add_run('小安智能助理｜老闆的專屬理財幫手  ◎ 小安製')
    fr.font.size = Pt(9)
    fr.font.color.rgb = RGBColor(0xAA, 0xAA, 0xAA)

    output_path = f'/Users/hsuehkaiyen/Desktop/📂 OpenClaw_下載/reports/daily/每日行程彙整_{date_str}.docx'
    doc.save(output_path)
    return output_path

def send_to_telegram(file_path):
    bot_token = '8546064006:AAE3Bw90cbOmN6hsKuUQVzMFI6BzdM55iUk'
    chat_id = '8766466278'
    today = datetime.datetime.now()
    caption = f"📋 每日行程彙整_{today.strftime('%Y年%m月%d日 %H:%M')}\n\n📧 Gmail · 📅 行事曆 · ✅ 代辦\n\n小安製"

    result = subprocess.run(
        ['curl', '-s', '-X', 'POST',
         f'https://api.telegram.org/bot{bot_token}/sendDocument',
         '-F', f'chat_id={chat_id}',
         '-F', f'document=@{file_path}',
         '-F', f'caption={caption}'],
        capture_output=True, text=True, timeout=30
    )
    response = json.loads(result.stdout)
    return response.get('ok', False)

if __name__ == '__main__':
    print(f'[{datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")}] 開始生成行程彙整...')
    try:
        report_path = generate_report()
        print(f'📄 報告已生成: {report_path}')
        if send_to_telegram(report_path):
            print('✅ 已發送到 Telegram')
        else:
            print('❌ 發送失敗')
        print(f'[{datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")}] 任務完成！')
    except Exception as e:
        print(f'❌ 錯誤: {e}')
