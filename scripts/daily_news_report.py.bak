#!/usr/bin/env python3
"""
全方位新聞報告生成腳本（直接使用 Yahoo RSS）
- Yahoo 新聞 RSS 來源
- 以台灣新聞為主
- 跨類別不重複
"""

from docx import Document
from docx.shared import Pt, RGBColor, Cm
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.oxml.ns import qn
from docx.oxml import OxmlElement
import subprocess
import datetime
import json
import os
import urllib.parse
import xml.etree.ElementTree as ET

# ========== 工具函數 ==========

def set_cell_bg(cell, hex_color):
    tc = cell._tc
    tcPr = tc.get_or_add_tcPr()
    shd = OxmlElement('w:shd')
    shd.set(qn('w:val'), 'clear')
    shd.set(qn('w:color'), 'auto')
    shd.set(qn('w:fill'), hex_color)
    tcPr.append(shd)

def make_header_cell(cell, text, bg='FFFFFF'):
    cell.text = text
    run = cell.paragraphs[0].runs[0]
    run.bold = True
    run.font.color.rgb = RGBColor(0x00, 0x00, 0x00)
    run.font.size = Pt(10)
    set_cell_bg(cell, bg)
    cell.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.CENTER

def add_data_cell(cell, text):
    cell.text = text
    run = cell.paragraphs[0].runs[0]
    run.font.size = Pt(9)
    cell.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.LEFT

# ========== Yahoo RSS 新聞取得 ==========

def fetch_yahoo_rss():
    """直接從 Yahoo RSS 取得新聞"""
    rss_urls = {
        'top': 'https://tw.news.yahoo.com/rss/',
    }
    all_news = []
    seen = set()
    
    for name, url in rss_urls.items():
        try:
            result = subprocess.run(['curl', '-s', '-L', '--max-time', '15', url], 
                                   capture_output=True, text=True, timeout=20)
            if result.stdout:
                root = ET.fromstring(result.stdout)
                for item in root.findall('.//item'):
                    title = item.find('title')
                    if title is not None and title.text:
                        title_text = title.text.strip()
                        # 清理 CDATA 或 HTML
                        title_text = title_text.replace('<![CDATA[', '').replace(']]>', '')
                        title_text = title_text.replace('<', '<').replace('>', '>')
                        if title_text not in seen:
                            seen.add(title_text)
                            link = item.find('link')
                            link_text = link.text if link is not None else ''
                            all_news.append((title_text, 'Yahoo新聞', link_text))
        except Exception as e:
            print(f"RSS fetch error: {e}")
    
    return all_news

def assign_by_category(all_news, category_keywords, count=4):
    """根據關鍵字分配新聞到類別，不重複"""
    assigned = []
    
    for kw in category_keywords:
        if len(assigned) >= count:
            break
        kw_lower = kw.lower()
        for news in all_news:
            if kw_lower in news[0].lower() and news not in assigned:
                assigned.append(news)

    if len(assigned) < count:
        for news in all_news:
            if news not in assigned:
                assigned.append(news)
            if len(assigned) >= count:
                break

    for news in assigned:
        if news in all_news:
            all_news.remove(news)

    return assigned[:count]

# ========== 主程式 ==========

def generate_report():
    today = datetime.datetime.now()
    date_str = today.strftime('%Y%m%d_%H%M')

    doc = Document()
    for section in doc.sections:
        section.top_margin = Cm(2)
        section.bottom_margin = Cm(2)
        section.left_margin = Cm(2.5)
        section.right_margin = Cm(2.5)

    # ===== 標題 =====
    title = doc.add_heading('📰 全方位新聞快報', 0)
    title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    tr = title.runs[0]
    tr.font.size = Pt(24)
    tr.font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    sub = doc.add_paragraph()
    sub.alignment = WD_ALIGN_PARAGRAPH.CENTER
    sr = sub.add_run('國際 · 財經 · 科技 · 政治 · 健康 · 體育')
    sr.font.size = Pt(12)
    sr.font.color.rgb = RGBColor(0x70, 0x70, 0x70)
    sr.font.italic = True

    date_para = doc.add_paragraph()
    date_para.alignment = WD_ALIGN_PARAGRAPH.CENTER
    dr = date_para.add_run('報告日期：' + today.strftime('%Y年%m月%d日 %H:%M'))
    dr.font.size = Pt(10)
    dr.font.color.rgb = RGBColor(0x99, 0x99, 0x99)

    doc.add_paragraph()

    # ===== 從 Yahoo RSS 取得新聞 =====
    all_news = fetch_yahoo_rss()

    # ===== 🌏 國際大事 =====
    h1 = doc.add_heading('一、🌏 國際大事', level=1)
    h1.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    intl_news = assign_by_category(all_news, ['美國', '兩岸', '美中', '美伊', '南海', '東海', '國際', '外交', '國際關係', '英國', '日本', '韓國', '歐洲', '習近平', '川普', '拜登', '聯合國', '以色列', '伊朗', '俄羅斯', '烏克蘭'], 4)
    if intl_news:
        for title, source, url in intl_news:
            p = doc.add_paragraph()
            p.add_run('• ').bold = True
            p.add_run(title)
            p.paragraph_format.space_after = Pt(6)
            p.paragraph_format.left_indent = Cm(0.3)
    else:
        p = doc.add_paragraph()
        p.add_run('（今日無最新國際大事）')
        p.paragraph_format.space_after = Pt(6)

    doc.add_paragraph()

    # ===== 📈 財經股市 ======
    h2 = doc.add_heading('二、📈 財經股市', level=1)
    h2.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    finance_news = assign_by_category(all_news, ['股市', '經濟', '投資', '財經', 'ETF', '市場', '金融', '美股', '台股', '债券', '股息', '上市', '櫃買', '營收', '獲利', '財報', 'IPO', 'Crypto', '虛擬貨幣', '銀行', '保險'], 4)
    if finance_news:
        for title, source, url in finance_news:
            p = doc.add_paragraph()
            p.add_run('• ').bold = True
            p.add_run(title)
            p.paragraph_format.space_after = Pt(6)
            p.paragraph_format.left_indent = Cm(0.3)
    else:
        p = doc.add_paragraph()
        p.add_run('（今日無最新財經新聞）')

    doc.add_paragraph()

    # ===== 🔬 科技AI ======
    h3 = doc.add_heading('三、🔬 科技AI', level=1)
    h3.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    tech_news = assign_by_category(all_news, ['AI', '科技', '技術', '人工智慧', '產業', '半導體', '晶片', '設備', '電子', '台積電', '聯發科', '科技業', '生成式AI', 'ChatGPT', 'Google', 'Microsoft', 'Apple', 'Nvidia', 'CPU', 'GPU'], 4)
    if tech_news:
        for title, source, url in tech_news:
            p = doc.add_paragraph()
            p.add_run('• ').bold = True
            p.add_run(title)
            p.paragraph_format.space_after = Pt(6)
            p.paragraph_format.left_indent = Cm(0.3)
    else:
        p = doc.add_paragraph()
        p.add_run('（今日無最新科技新聞）')

    doc.add_paragraph()

    # ===== 🏛️ 政治新聞 ======
    h4 = doc.add_heading('四、🏛️ 政治新聞', level=1)
    h4.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    tw_news = assign_by_category(all_news, ['政治', '國會', '立法', '政府', '執政', '在野', '政黨', '選舉', '內政', '司法', '改革', '一例一休', '打炒房', '囤房稅', '國發會', '數位部', '陸委會', '外交部', '國防部', '行政院'], 4)
    if tw_news:
        for title, source, url in tw_news:
            p = doc.add_paragraph()
            p.add_run('• ').bold = True
            p.add_run(title)
            p.paragraph_format.space_after = Pt(6)
            p.paragraph_format.left_indent = Cm(0.3)
    else:
        p = doc.add_paragraph()
        p.add_run('（今日無最新政治新聞）')

    doc.add_paragraph()

    # ===== 🏥 健康資訊 ======
    h5 = doc.add_heading('五、🏥 健康資訊', level=1)
    h5.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    health_news = assign_by_category(all_news, ['健康', '醫療', '疾病', '藥品', '保健', '身體', '治療', '醫學', '疫苗', '癌症', '新冠', '確診', '疫情', '健保', '長照', '醫院', '醫師', '健康'], 4)
    if health_news:
        for title, source, url in health_news:
            p = doc.add_paragraph()
            p.add_run('• ').bold = True
            p.add_run(title)
            p.paragraph_format.space_after = Pt(6)
            p.paragraph_format.left_indent = Cm(0.3)
    else:
        p = doc.add_paragraph()
        p.add_run('（今日無最新健康資訊）')

    doc.add_paragraph()

    # ===== ⚽ 體育消息 ======
    h6 = doc.add_heading('六、⚽ 體育消息', level=1)
    h6.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    sports_news = assign_by_category(all_news, ['運動', '棒球', '籃球', '足球', '體育', 'MLB', 'NBA', '日職', '中華職棒', '中職', 'CPBL', '足球', '田徑', '游泳', '奧運', '亞運', '高爾夫', '網球'], 4)
    if sports_news:
        for title, source, url in sports_news:
            p = doc.add_paragraph()
            p.add_run('• ').bold = True
            p.add_run(title)
            p.paragraph_format.space_after = Pt(6)
            p.paragraph_format.left_indent = Cm(0.3)
    else:
        p = doc.add_paragraph()
        p.add_run('（今日無最新體育消息）')

    doc.add_paragraph()

    # ===== 📊 今日摘要表格 ======
    h7 = doc.add_heading('七、📊 今日重點摘要', level=1)
    h7.runs[0].font.color.rgb = RGBColor(0x1F, 0x49, 0x7D)

    summary_table = doc.add_table(rows=7, cols=2)
    summary_table.style = 'Table Grid'
    summary_table.alignment = WD_TABLE_ALIGNMENT.CENTER
    make_header_cell(summary_table.rows[0].cells[0], '類別')
    make_header_cell(summary_table.rows[0].cells[1], '重點')

    summary_data = [
        ('🌏 國際', '美中台關係、國際外交、兩岸局勢'),
        ('📈 財經', '台股行情、總體經濟、產業趨勢'),
        ('🔬 科技', 'AI發展、半導體、區域科技動態'),
        ('🏛️ 政治', '台灣內政、國會動態、政策走向'),
        ('🏥 健康', '醫療資訊、疾病預防、健康趨勢'),
        ('⚽ 體育', '棒球、籃球、國際體育賽事'),
    ]
    for ri, (cat, content) in enumerate(summary_data):
        row = summary_table.rows[ri + 1]
        add_data_cell(row.cells[0], cat)
        add_data_cell(row.cells[1], content)

    doc.add_paragraph()

    # 頁尾
    footer = doc.sections[0].footer
    fp = footer.paragraphs[0]
    fp.alignment = WD_ALIGN_PARAGRAPH.CENTER
    fr = fp.add_run('小安智能助理｜老闆的專屬理財幫手  ◎ 小安製')
    fr.font.size = Pt(9)
    fr.font.color.rgb = RGBColor(0xAA, 0xAA, 0xAA)

    output_path = f'/Users/hsuehkaiyen/.openclaw/workspace/全方位新聞快報_{date_str}.docx'
    doc.save(output_path)
    return output_path

def send_to_telegram(file_path):
    bot_token = '8546064006:AAE3Bw90cbOmN6hsKuUQVzMFI6BzdM55iUk'
    chat_id = '8766466278'
    today = datetime.datetime.now()
    caption = f"📰 全方位新聞快報_{today.strftime('%Y年%m月%d日 %H:%M')}\n\n🌏 國際 · 📈 財經 · 🔬 科技\n🏛️ 政治 · 🏥 健康 · ⚽ 體育\n\n小安製"

    result = subprocess.run(
        ['curl', '-s', '-X', 'POST',
         f'https://api.telegram.org/bot{bot_token}/sendDocument',
         '-F', f'chat_id={chat_id}',
         '-F', f'document=@{file_path}',
         '-F', f'caption={caption}'],
        capture_output=True, text=True, timeout=30
    )
    try:
        response = json.loads(result.stdout)
        return response.get('ok', False)
    except:
        return False

if __name__ == '__main__':
    print(f'[{datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")}] 開始生成新聞快報...')
    try:
        report_path = generate_report()
        print(f'📄 報告已生成: {report_path}')
        if send_to_telegram(report_path):
            print('✅ 已發送到 Telegram')
        else:
            print('❌ 發送失敗')
        print(f'[{datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")}] 任務完成！')
    except Exception as e:
        print(f'❌ 錯誤: {e}')
        import traceback
        traceback.print_exc()